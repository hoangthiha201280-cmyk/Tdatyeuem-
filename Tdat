local function Corner(obj, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 8)
    c.Parent = obj
end

local function MakeLabel(parent, text, size, pos, textSize, color)
    local x = Instance.new("TextLabel")
    x.BackgroundTransparency = 1
    x.Size = size
    x.Position = pos
    x.Text = text
    x.TextColor3 = color or Colors.Text
    x.TextSize = textSize or 14
    x.Font = Enum.Font.Gotham
    x.TextXAlignment = Enum.TextXAlignment.Left
    x.Parent = parent
    return x
end

local function MakeButton(parent, text, size, pos)
    local b = Instance.new("TextButton")
    b.Size = size
    b.Position = pos
    b.Text = text
    b.TextColor3 = Colors.Text
    b.TextSize = 13
    b.Font = Enum.Font.GothamMedium
    b.BackgroundColor3 = Colors.Element
    b.AutoButtonColor = false
    b.Parent = parent

    Corner(b, 7)

    b.MouseEnter:Connect(function()
        b.BackgroundColor3 = Colors.Hover
    end)

    b.MouseLeave:Connect(function()
        b.BackgroundColor3 = Colors.Element
    end)

    return b
end

