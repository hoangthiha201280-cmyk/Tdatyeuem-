local function Toggle(parent, text, initial, callback)

    local holder = Instance.new("Frame")
    holder.Size = UDim2.new(1,-5,0,55)
    holder.BackgroundColor3 = Colors.Element
    holder.Parent = parent

    Corner(holder,8)

    MakeLabel(
        holder,
        text,
        UDim2.new(1,-80,0,25),
        UDim2.fromOffset(13,8),
        13,
        Colors.Text
    )

    local value = initial

    local switch = Instance.new("TextButton")
    switch.Size = UDim2.fromOffset(45,24)
    switch.Position = UDim2.new(1,-58,.5,-12)
    switch.Text = ""
    switch.AutoButtonColor = false
    switch.Parent = holder

    Corner(switch,12)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(18,18)
    knob.BackgroundColor3 = Colors.White
    knob.Parent = switch

    Corner(knob,10)

    local function Update()
        switch.BackgroundColor3 =
            value and Colors.Accent or Colors.Hover

        knob.Position = value
            and UDim2.new(1,-21,.5,-9)
            or UDim2.fromOffset(3,3)

        callback(value)
    end

    switch.Activated:Connect(function()
        value = not value
        Update()
    end)

    Update()
end

--==================================================
-- SLIDER
--==================================================

local function Slider(parent, text, min, max, default, callback)

    local holder = Instance.new("Frame")
    holder.Size = UDim2.new(1,-5,0,72)
    holder.BackgroundColor3 = Colors.Element
    holder.Parent = parent

    Corner(holder,8)

    MakeLabel(
        holder,
        text,
        UDim2.new(1,-70,0,25),
        UDim2.fromOffset(13,8),
        13,
        Colors.Text
    )

    local valueText = MakeLabel(
        holder,
        tostring(default),
        UDim2.fromOffset(50,25),
        UDim2.new(1,-63,0,8),
        12,
        Colors.Sub
    )

    valueText.TextXAlignment = Enum.TextXAlignment.Right

    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(1,-26,0,6)
    bar.Position = UDim2.fromOffset(13,50)
    bar.BackgroundColor3 = Colors.Hover
    bar.Parent = holder

    Corner(bar,5)

    local fill = Instance.new("Frame")
    fill.BackgroundColor3 = Colors.Accent
    fill.Size = UDim2.new(
        (default-min)/(max-min),
        0,1,0
    )
    fill.Parent = bar

    Corner(fill,5)

    local sliding = false

    local function SetValue(x)
        local percent = math.clamp(
            (x-bar.AbsolutePosition.X)/bar.AbsoluteSize.X,
            0,1
        )

        local value = math.floor(
            min+(max-min)*percent+.5
        )

        fill.Size = UDim2.new(percent,0,1,0)
        valueText.Text = tostring(value)

        callback(value)
    end

    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then

            sliding = true
            SetValue(input.Position.X)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if sliding then
            if input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch then

                SetValue(input.Position.X)
            end
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then

            sliding = false
        end
    end)

    callback(default)
end

